# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# The backend reads these as environment variables (see application.yml).
# NOTE: no spaces around `=`  (e.g. META_ACCESS_TOKEN=EAAxxx, not `= EAAxxx`).

# System User token with the `ads_read` scope (Business Settings -> System Users -> Generate Token).
META_ACCESS_TOKEN=

# Ad account id. Either `1234567890` or `act_1234567890` works.
META_AD_ACCOUNT_ID=

# Optional: override the frontend origin(s) allowed to call the API (comma-separated).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
